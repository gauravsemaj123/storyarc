2d_render/layer_4="scenechange"
2d_render/layer_5="comms"
2d_render/layer_6="water"
2d_physics/layer_1="physic"
2d_physics/layer_3="camerabounds"
2d_physics/layer_4="scenechange"
2d_physics/layer_5="comms"
2d_physics/layer_6="water"
2d_physics/layer_7="door"

[questify]

general/update_polling=true
general/update_interval=0.5

[rendering]

rendering_device/vsync/swapchain_image_count=2
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
