; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Story Arc"
config/version="0.0.1"
run/main_scene="res://disclaimer.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=90
run/frame_delay_msec=2
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://noimage.png"
config/icon="res://game.svg"

[audio]

buses/default_bus_layout=""

[autoload]

NavigationManager="*res://scripts/navigation_manager.gd"
InteractionManager="*res://ui/misc/interaction/InteractionManager.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Transition="*res://scenes/scene_changer/transitions/transition.tscn"
Signage="*res://ui/stageprompter/signage.tscn"
Global="*res://inventorymain/Global.gd"
Questlines="*res://scripts/Questlines.gd"
Notifier="*res://scripts/elements/notifier.gd"
DoorInteractionManager="*res://scenes/scene_changer/DoorInteractionManager.tscn"
MinigameResources="*res://scripts/minigame_resources.gd"
TransferrerCutscene="*res://scenes/scene_changer/transferrer_cutscene.tscn"
JustFade="*res://ui/misc/just_fade.tscn"
Cutscene="*res://ui/misc/cutscene.tscn"
ItemDetection="*res://scripts/itemDetection.gd"
Weather="*res://scenes/weather/weather.tscn"
AUDIO="*res://sounds/SFX/audio.tscn"
GlobalstateQ2="*res://scripts/elements/globalstateQ2.gd"

[display]

window/size/mode=2
window/size/initial_position_type=0
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom_font="res://ui/fonts/PIXEARG_.TTF"

[importer_defaults]

animation_library={
"animation/fps": 60.0,
"animation/trimming": true
}

